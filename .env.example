# ==============================================================================
# RITMO — Variáveis de Ambiente & Configurações de Serviços
# Copie este arquivo para .env.local para desenvolvimento local
# Nunca faça commit de segredos ou chaves privadas reais
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Autenticação e Segurança (JWT) — OBRIGATÓRIO em produção
# Gere um valor longo e aleatório só seu. O valor de exemplo abaixo NÃO deve
# ir para produção — qualquer pessoa com ele consegue forjar sessões de login.
# ------------------------------------------------------------------------------
JWT_SECRET="troque-por-um-valor-aleatorio-longo-antes-de-publicar"

# E-mail(s) que viram ADMINISTRADOR ao cadastrar ou entrar (separe por vírgula).
# Use só para criar o primeiro admin e REMOVA a variável depois.
ADMIN_EMAILS="seu-email@exemplo.com"

# ------------------------------------------------------------------------------
# 2. Netlify Database (PostgreSQL Gerenciado)
# Gerenciado automaticamente pela plataforma Netlify no primeiro deploy.
# Não é necessário configurar connection string manual.
# ------------------------------------------------------------------------------
# NETLIFY_DB_URL=... (Injetado automaticamente pelo Netlify)

# ------------------------------------------------------------------------------
# 3. Mercado Pago (Pix real + Checkout Pro para cartão) — necessário para
# comercializar de verdade. Sem isso, o checkout fica em modo demonstração,
# claramente identificado na interface, sem cobrar ninguém de verdade.
# Painel: https://www.mercadopago.com.br/developers/panel
# ------------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=""
# Opcional, mas recomendado: valida a assinatura das notificações de webhook
# (Suas integrações > sua aplicação > Webhooks > Chave secreta)
MERCADOPAGO_WEBHOOK_SECRET=""
# Opcional: URL pública que o Mercado Pago deve notificar a cada pagamento.
# Se não definida, o app ainda funciona via checagem manual/polling na tela.
MERCADOPAGO_WEBHOOK_URL="https://meu-ritmo.netlify.app/api/webhooks/mercadopago"

# ------------------------------------------------------------------------------
# 4. E-mail transacional (Resend) — necessário para recuperação de senha e
# confirmação de pagamento por e-mail de verdade. Sem isso, o código de
# recuperação aparece na tela (modo de demonstração/desenvolvimento, inseguro
# para produção).
# https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Ritmo <nao-responda@meu-ritmo.netlify.app>"

# ------------------------------------------------------------------------------
# 4b. Lembretes diários de vencimento (teste acabando / assinatura vencendo)
# Invente um texto longo e aleatório. Usado pela função agendada da Netlify.
# ------------------------------------------------------------------------------
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 5. WhatsApp Business Cloud API (Oficial Meta) — opcional
# Obtenha no Meta for Developers (https://developers.facebook.com)
# ------------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN="ritmo-whatsapp-webhook-token"
WHATSAPP_PHONE_NUMBER_ID="seu_phone_number_id_aqui"
WHATSAPP_ACCESS_TOKEN="seu_system_user_access_token_aqui"
WHATSAPP_APP_SECRET="seu_app_secret_aqui"

# ------------------------------------------------------------------------------
# 6. Google Sheets API (Sincronização de Planilha) — opcional
# Obtenha no Google Cloud Console criando uma Conta de Serviço (Service Account)
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"seu-projeto","private_key_id":"...","private_key":"...","client_email":"sua-conta@seu-projeto.iam.gserviceaccount.com"}'

# ------------------------------------------------------------------------------
# Observação sobre o programa de afiliados: o percentual de comissão (60%),
# saque mínimo e janela de atribuição NÃO são configurados por variável de
# ambiente — ficam na tabela affiliate_settings do banco e são editados pelo
# painel /admin do próprio app.
# ------------------------------------------------------------------------------
